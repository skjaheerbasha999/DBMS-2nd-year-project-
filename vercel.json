{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://dbms-2nd-year-project-3.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ]
}
